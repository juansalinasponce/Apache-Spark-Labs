// Crear cada medida por separado. Nombres de tablas sin prefijo gld.
Total Cuentas = COUNTROWS ( dim_cuenta )
Clientes con Cuenta = DISTINCTCOUNT ( dim_cuenta[id_cliente] )
Cuentas Activas = CALCULATE ( [Total Cuentas], KEEPFILTERS ( dim_cuenta[estado] = "ACTIVA" ) )
Saldo PEN = CALCULATE ( SUM ( dim_cuenta[saldo_actual] ), KEEPFILTERS ( dim_cuenta[moneda] = "PEN" ) )
Saldo USD = CALCULATE ( SUM ( dim_cuenta[saldo_actual] ), KEEPFILTERS ( dim_cuenta[moneda] = "USD" ) )
Total Transacciones = COUNTROWS ( fct_transaccion )
Transacciones Aprobadas = CALCULATE ( [Total Transacciones], KEEPFILTERS ( fct_transaccion[estado] = "APROBADA" ) )
Porcentaje Aprobacion = DIVIDE ( [Transacciones Aprobadas], [Total Transacciones], 0 )
Cuentas con Operaciones = DISTINCTCOUNT ( fct_transaccion[id_cuenta] )
Monto Aprobado PEN = CALCULATE ( SUM ( fct_transaccion[monto] ), KEEPFILTERS ( fct_transaccion[estado] = "APROBADA" ), KEEPFILTERS ( dim_cuenta[moneda] = "PEN" ) )
Monto Aprobado USD = CALCULATE ( SUM ( fct_transaccion[monto] ), KEEPFILTERS ( fct_transaccion[estado] = "APROBADA" ), KEEPFILTERS ( dim_cuenta[moneda] = "USD" ) )
Ticket Promedio PEN = DIVIDE ( [Monto Aprobado PEN], CALCULATE ( [Transacciones Aprobadas], KEEPFILTERS ( dim_cuenta[moneda] = "PEN" ) ) )
Ultima Fecha Operacion = MAX ( fct_transaccion[fecha_transaccion] )
